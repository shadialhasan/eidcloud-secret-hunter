#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * eidcloud-secret-hunter CLI Executable
 *
 * @author Eng. MHD. Shadi AL-Hasan <mhd.shadi.alhasan@gmail.com>
 * @license MIT
 */

// Autoload dependencies
if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} else {
    require_once __DIR__ . '/../src/autoload.php';
}

use EidCloud\SecretHunter\Git\GitHistoryScanner;
use EidCloud\SecretHunter\Report\ConsoleReporter;
use EidCloud\SecretHunter\Report\JsonReporter;
use EidCloud\SecretHunter\Rules\RuleRegistry;
use EidCloud\SecretHunter\Rules\Severity;
use EidCloud\SecretHunter\Scanner;

const VERSION = '1.0.0';

function showHelp(): void
{
    echo <<<HELP
🛡️  eidcloud-secret-hunter v1.0.0
High-velocity secrets, tokens, and credential detection scanner for codebases & Git.

USAGE:
  php bin/eidcloud-secrets <command> [path] [options]

COMMANDS:
  scan [path]         Scan a codebase directory or single file (default: .)
  git-scan [path]     Scan Git commit history and diffs for historical leaks
  rules               List all built-in detection rules and signatures
  version, -v         Display tool version

OPTIONS:
  --mask              Mask secret characters in output (e.g., sk-proj-****AbCd) [default: on]
  --no-mask           Display raw unmasked secret values (Caution!)
  --json              Output scan results in machine-readable JSON format
  --min-severity=LVL  Minimum severity to report: critical, high, medium, low [default: low]
  --fail-on=LVL       Minimum severity to trigger non-zero exit code [default: high]
  --depth=NUM         Git history commit depth limit for git-scan [default: 100]
  --ignore=DIRS       Comma-separated list of additional directories to ignore
  --no-color          Disable ANSI color formatting
  -h, --help          Show this help information
  -v, --version       Show version information

EXAMPLES:
  php bin/eidcloud-secrets scan . --mask
  php bin/eidcloud-secrets scan . --json --min-severity=high
  php bin/eidcloud-secrets scan ./src --fail-on=critical
  php bin/eidcloud-secrets git-scan . --depth=50 --mask
  php bin/eidcloud-secrets rules

EXIT CODES:
  0 = Clean / No secrets violating severity threshold detected
  1 = Blocker / Secrets violating severity threshold detected
  2 = Execution error or invalid configuration

HELP;
}

$argv = $_SERVER['argv'];
array_shift($argv); // Remove script name

if (empty($argv) || in_array('--help', $argv, true) || in_array('-h', $argv, true)) {
    showHelp();
    exit(0);
}

if (in_array('--version', $argv, true) || in_array('-v', $argv, true) || in_array('version', $argv, true)) {
    echo "eidcloud-secret-hunter version " . VERSION . " (PHP " . PHP_VERSION . ")\n";
    exit(0);
}

$command = 'scan';
$targetPath = '.';
$mask = true;
$isJson = false;
$minSeverity = Severity::LOW;
$failOnSeverity = Severity::HIGH;
$depth = 100;
$ignorePaths = [];
$noColor = false;

// Command extraction
$positionals = [];
foreach ($argv as $arg) {
    if (str_starts_with($arg, '--')) {
        $parts = explode('=', substr($arg, 2), 2);
        $optKey = $parts[0];
        $optVal = $parts[1] ?? true;

        match ($optKey) {
            'mask' => $mask = true,
            'no-mask' => $mask = false,
            'json' => $isJson = true,
            'no-color' => $noColor = true,
            'min-severity' => $minSeverity = is_string($optVal) ? strtolower($optVal) : Severity::LOW,
            'fail-on' => $failOnSeverity = is_string($optVal) ? strtolower($optVal) : Severity::HIGH,
            'depth' => $depth = (int)$optVal,
            'ignore' => $ignorePaths = is_string($optVal) ? explode(',', $optVal) : [],
            default => null,
        };
    } elseif (str_starts_with($arg, '-')) {
        if ($arg === '-h') {
            showHelp();
            exit(0);
        }
        if ($arg === '-v') {
            echo "eidcloud-secret-hunter version " . VERSION . "\n";
            exit(0);
        }
    } else {
        $positionals[] = $arg;
    }
}

if (!empty($positionals)) {
    if (in_array($positionals[0], ['scan', 'git-scan', 'rules'], true)) {
        $command = array_shift($positionals);
        if (!empty($positionals)) {
            $targetPath = array_shift($positionals);
        }
    } else {
        $targetPath = array_shift($positionals);
    }
}

// Validate severity
if (!Severity::isValid($minSeverity)) {
    fwrite(STDERR, "Error: Invalid min-severity '{$minSeverity}'. Choose from: " . implode(', ', Severity::all()) . "\n");
    exit(2);
}

if (!Severity::isValid($failOnSeverity)) {
    fwrite(STDERR, "Error: Invalid fail-on severity '{$failOnSeverity}'. Choose from: " . implode(', ', Severity::all()) . "\n");
    exit(2);
}

// Handle 'rules' command
if ($command === 'rules') {
    $registry = RuleRegistry::create();
    $rules = $registry->getAll();

    if ($isJson) {
        $data = [];
        foreach ($rules as $rule) {
            $data[] = [
                'id'          => $rule->id,
                'name'        => $rule->name,
                'severity'    => $rule->severity,
                'category'    => $rule->category,
                'description' => $rule->description,
                'entropy'     => $rule->entropyThreshold,
            ];
        }
        echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
        exit(0);
    }

    echo "🛡️  eidcloud-secret-hunter - Registered Rules (" . count($rules) . " rules)\n";
    echo str_repeat("─", 72) . "\n";
    printf("%-28s %-12s %-16s %s\n", "RULE ID", "SEVERITY", "CATEGORY", "NAME");
    echo str_repeat("─", 72) . "\n";
    foreach ($rules as $rule) {
        printf("%-28s %-12s %-16s %s\n", $rule->id, strtoupper($rule->severity), $rule->category, $rule->name);
    }
    echo str_repeat("─", 72) . "\n";
    exit(0);
}

try {
    if ($command === 'git-scan') {
        $gitScanner = new GitHistoryScanner();
        $scanResult = $gitScanner->scanHistory($targetPath, $depth, $minSeverity);
    } else {
        $scanner = new Scanner();
        if (is_file($targetPath)) {
            $findings = $scanner->scanFile($targetPath, ['minSeverity' => $minSeverity]);
            $scanResult = new \EidCloud\SecretHunter\Models\ScanResult($findings, $targetPath);
            $scanResult->scannedFilesCount = 1;
            $scanResult->scannedLinesCount = count(file($targetPath) ?: []);
        } else {
            $scanResult = $scanner->scanDirectory($targetPath, [
                'minSeverity' => $minSeverity,
                'ignorePaths' => $ignorePaths,
            ]);
        }
    }

    if ($isJson) {
        echo JsonReporter::render($scanResult, $mask, $minSeverity) . "\n";
    } else {
        $reporter = new ConsoleReporter($noColor ? false : null);
        echo $reporter->render($scanResult, $mask, $minSeverity);
    }

    // Exit code: 1 if violations meeting fail-on severity threshold exist, 0 if clean
    if ($scanResult->hasViolations($failOnSeverity)) {
        exit(1);
    }

    exit(0);
} catch (\Throwable $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    exit(2);
}
